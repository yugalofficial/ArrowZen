<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.ArrowZen" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash theme using AndroidX SplashScreen compat API (Section 45). -->
    <style name="Theme.ArrowZen.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/arrowzen_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.ArrowZen</item>
    </style>
</resources>
